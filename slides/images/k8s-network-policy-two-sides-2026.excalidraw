      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Isolation is specific to each direction.\nRules from matching policies are additive.\nReply traffic for an allowed connection is allowed.\nThe network plugin must enforce NetworkPolicy.",
      "autoResize": true,
      "lineHeight": 1.25,
      "id": "behavior",
      "type": "text",
      "x": 795,
      "y": 598,
      "width": 567.962890625,
      "height": 130,
      "text": "Isolation is specific to each direction.\nRules from matching policies are additive.\nReply traffic for an allowed connection is allowed.\nThe network plugin must enforce NetworkPolicy."
    },
